# По умолчанию — LF
* text=auto eol=lf

# Python и shell — строго LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows-специфичные — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы — не трогать
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.zip binary